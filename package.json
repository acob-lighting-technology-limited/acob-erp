{
  "name": "matrix",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/clean-next.mjs && node scripts/copy-pdf-engines.mjs && next build --webpack",
    "postinstall": "node scripts/copy-pdf-engines.mjs",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:strict": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commit": "cz",
    "type-check": "tsc --noEmit",
    "dup:check": "npx --yes jscpd@4",
    "deadcode": "npx --yes knip@5",
    "test": "npm run test:audit && npm run test:auth && npm run test:signature && npm run test:ui-ratchet && npm run test:admin-scope && npm run test:meeting-week && npm run test:attendance && npm run test:task-scoring && npm run test:project-health && npm run test:scorecard && npm run test:starlink && npm run test:requisitions && npm run test:risk-register && npm run test:sites && npm run test:export && npm run test:pdf",
    "test:pdf": "tsx --test lib/pdf/__tests__/*.test.ts",
    "test:forms": "tsx --test lib/forms/__tests__/*.test.ts",
    "test:audit": "tsx --test lib/audit/__tests__/*.test.ts",
    "test:auth": "tsx --test lib/auth/__tests__/*.test.ts",
    "test:signature": "tsx --test lib/signature/__tests__/*.test.ts",
    "test:admin-scope": "tsx --test lib/admin/__tests__/*.test.ts",
    "test:meeting-week": "tsx --test lib/__tests__/*.test.ts",
    "test:attendance": "tsx --test lib/hr/__tests__/*.test.ts",
    "test:task-scoring": "tsx --test lib/tasks/__tests__/*.test.ts",
    "test:project-health": "tsx --test lib/projects/__tests__/*.test.ts",
    "test:scorecard": "tsx --test lib/corporate-scorecard/__tests__/*.test.ts",
    "test:starlink": "tsx --test lib/starlink/__tests__/*.test.ts",
    "test:requisitions": "tsx --test lib/requisitions/__tests__/*.test.ts lib/approval-signing/__tests__/*.test.ts",
    "test:export": "tsx --test lib/export/__tests__/*.test.ts",
    "test:risk-register": "tsx --test lib/risk-register/__tests__/*.test.ts",
    "test:sites": "tsx --test lib/sites/__tests__/*.test.ts",
    "test:campaign": "tsx scripts/test-campaign/run.ts",
    "test:campaign:inventory": "tsx scripts/test-campaign/run.ts --inventory-only",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ui:ensure-loading": "node scripts/ui/ensure-loading.mjs",
    "ui:audit": "node scripts/ui/audit-reusables.mjs",
    "ui:audit:baseline": "node scripts/ui/audit-reusables.mjs --write-allowlist",
    "ui:ratchet": "node scripts/ui/ratchet.mjs",
    "ui:ratchet:update": "node scripts/ui/ratchet.mjs --update",
    "ui:guard": "npm run ui:audit && npm run ui:ratchet",
    "test:ui-ratchet": "node --test scripts/ui/__tests__/ratchet.test.mjs",
    "security:anon-probe": "node scripts/anon-security-probe.mjs",
    "check-all": "npm run lint && npm run format:check && npm run type-check && npm run ui:guard",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/groq": "^1.2.9",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@e965/xlsx": "^0.20.3",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@hookform/resolvers": "^3.10.0",
    "@neslinesli93/qpdf-wasm": "0.3.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.76.1",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tesseract.js-data/eng": "1.0.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^1.3.1",
    "ai": "^4.3.19",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "docx": "^9.5.1",
    "dompurify": "^3.4.13",
    "dotenv": "^17.3.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.23.24",
    "geist": "^1.3.1",
    "heic2any": "^0.0.4",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "jszip": "^3.10.1",
    "lucide-react": "^0.454.0",
    "next": "^16.3.8",
    "next-themes": "^0.4.6",
    "nprogress": "^0.2.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "5.4.296",
    "pptxgenjs": "^4.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-day-picker": "9.8.0",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.60.0",
    "react-markdown": "^10.1.0",
    "recharts": "2.15.4",
    "remark-gfm": "^4.0.1",
    "resend": "^6.9.2",
    "sharp": "^0.34.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "7.0.0",
    "vaul": "^1.1.2",
    "web-push": "^3.6.7",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@playwright/test": "^1.54.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/dompurify": "^3.0.5",
    "@types/file-saver": "^2.0.7",
    "@types/jszip": "^3.4.0",
    "@types/node": "^22",
    "@types/nprogress": "^0.2.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.26",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,md}": [
      "prettier --write"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "overrides": {
    "postcss": "$postcss",
    "picomatch": "4.0.4",
    "fast-uri": "3.1.2",
    "yaml": "2.8.3",
    "brace-expansion": "1.1.13",
    "tmp": "0.2.4",
    "lodash": "4.18.1"
  }
}
