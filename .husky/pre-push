#!/bin/sh

# Read refs git passes on stdin before running checks (<local ref> <local sha> <remote ref> <remote sha>)
pushed_refs=""
if [ ! -t 0 ]; then
  pushed_refs=$(cat)
fi

# Prevent direct pushes to main branch
protected_branch='main'
current_branch=$(git symbolic-ref HEAD | sed -e 's,.*/\(.*\),\1,')

if [ "$protected_branch" = "$current_branch" ]; then
  echo "Direct pushes to '$protected_branch' branch are not allowed!"
  echo "Please create a feature branch and use a Pull Request instead."
  echo ""
  echo "   Example:"
  echo "   git checkout -b feature/your-feature-name"
  echo "   git push origin feature/your-feature-name"
  echo ""
  exit 1
fi

echo "Running strict lint before push..."
npm run lint:strict

if [ $? -ne 0 ]; then
  echo "Strict lint failed! Push aborted."
  exit 1
fi

echo "Running type-check before push..."
npm run type-check

if [ $? -ne 0 ]; then
  echo "Type-check failed! Push aborted."
  exit 1
fi

echo "Running UI guard (audit + ratchet) on pushed commit(s)..."
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_sha" ] && continue
  case "$local_sha" in
    *[!0]*)
      tmp=$(mktemp -d)
      if [ ! -d "$tmp" ]; then
        echo "Failed to create temporary directory for UI guard."
        exit 1
      fi

      if ! git archive "$local_sha" | tar -x -C "$tmp"; then
        echo "Failed to export commit $local_sha for UI guard."
        rm -rf "$tmp"
        exit 1
      fi

      (cd "$tmp" && node scripts/ui/audit-reusables.mjs && node scripts/ui/ratchet.mjs)
      status=$?
      rm -rf "$tmp"

      if [ $status -ne 0 ]; then
        echo "UI guard failed on commit $local_sha! Push aborted."
        exit 1
      fi
      ;;
  esac
done <<EOF
$pushed_refs
EOF

echo "Checks passed. Proceeding with push..."
